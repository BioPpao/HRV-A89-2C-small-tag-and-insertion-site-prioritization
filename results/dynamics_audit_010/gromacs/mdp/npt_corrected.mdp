define = -DPOSRES
dt = 0.002
nsteps = 250000
nstxout-compressed = 5000
nstenergy = 500
nstlog = 500
continuation = yes
constraint_algorithm = lincs
constraints = h-bonds
cutoff-scheme = Verlet
vdwtype = cutoff
vdw-modifier = force-switch
rlist = 1.2
rvdw-switch = 1.0
rvdw = 1.2
coulombtype = PME
rcoulomb = 1.2
DispCorr = no
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 1.0 1.0
ref_t = 300 300
pbc = xyz
gen_vel = no
gen_temp = 300
gen_seed = -1
pcoupl = C-rescale
pcoupltype = isotropic
tau_p = 5.0
ref_p = 1.0
compressibility = 4.5e-5
refcoord_scaling = com
