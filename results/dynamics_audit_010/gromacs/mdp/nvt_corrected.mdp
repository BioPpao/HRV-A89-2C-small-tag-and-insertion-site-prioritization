define = -DPOSRES
dt = 0.002
nsteps = 50000
nstxout-compressed = 5000
nstenergy = 500
nstlog = 500
continuation = no
constraint_algorithm = lincs
constraints = h-bonds
cutoff-scheme = Verlet
vdwtype = cutoff
vdw-modifier = force-switch
rlist = 1.2
rvdw-switch = 1.0
rvdw = 1.2
coulombtype = PME
rcoulomb = 1.2
DispCorr = no
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 1.0 1.0
ref_t = 300 300
pbc = xyz
gen_vel = yes
gen_temp = 300
gen_seed = 10010
pcoupl = no
